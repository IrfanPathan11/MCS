#include <stdio.h>
#include <limits.h>
#define MAXN 10

int optimalBST(int freq[], int n) {
    int cost[MAXN][MAXN] = {0};
    int i, j, r, length;
    for (i = 0; i < n; i++) cost[i][i] = freq[i];
    for (length = 2; length <= n; length++) {
        for (i = 0; i <= n-length; i++) {
            j = i + length - 1;
            cost[i][j] = INT_MAX;
            int total = 0;
            for (r = i; r <= j; r++) total += freq[r];
            for (r = i; r <= j; r++) {
                int c = (r>i ? cost[i][r-1] : 0)
                      + (r<j ? cost[r+1][j] : 0) + total;
                if (c < cost[i][j]) cost[i][j] = c;
            }
        }
    }
    return cost[0][n-1];
}

int main() {
    int keys[] = {10, 20, 30, 40};
    int freq[] = { 4,  2,  6,  3};
    printf("Optimal BST cost: %d\n", optimalBST(freq, 4));
    printf("Best Case: O(n^2)   Worst Case: O(n^3)\n");
    return 0;
}
