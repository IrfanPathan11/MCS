#include <stdio.h>
#define MAXN 4

int w[]={2,3,4,5}, v[]={3,4,5,6}, n=MAXN, cap=5;
int bestVal = 0;

float upperBound(int level, int weight, int profit) {
    float ub=profit; float rem=cap-weight;
    int i;
    for (i=level; i<n; i++) {
        if (w[i]<=rem) { rem-=w[i]; ub+=v[i]; }
        else { ub+=rem*(float)v[i]/w[i]; break; }
    }
    return ub;
}

void bnb(int level, int weight, int profit) {
    if (level==n) { if(profit>bestVal) bestVal=profit; return; }
    /* Include item */
    if (weight+w[level]<=cap) {
        if (profit+v[level]>bestVal) bestVal=profit+v[level];
        if (upperBound(level+1,weight+w[level],profit+v[level])>bestVal)
            bnb(level+1, weight+w[level], profit+v[level]);
    }
    /* Exclude item */
    if (upperBound(level+1,weight,profit)>bestVal)
        bnb(level+1, weight, profit);
}

int main() {
    bnb(0, 0, 0);
    printf("0/1 Knapsack (LCBB) Max Value: %d\n", bestVal);
    return 0;
}
