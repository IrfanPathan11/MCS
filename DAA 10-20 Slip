#include <stdio.h>
#define N 4

int board[N], solutions = 0;

int isSafe(int row, int col) {
    int r;
    for (r=0; r<row; r++)
        if (board[r]==col || abs(board[r]-col)==abs(r-row)) return 0;
    return 1;
}

void printBoard() {
    int i, j;
    printf("Solution %d:\n", solutions);
    for (i=0;i<N;i++) {
        for (j=0;j<N;j++) printf("[%s]", board[i]==j?"Q":" ");
        printf("\n");
    }
    printf("\n");
}

void solve(int row) {
    if (row==N) { solutions++; printBoard(); return; }
    int col;
    for (col=0;col<N;col++)
        if (isSafe(row,col)) { board[row]=col; solve(row+1); board[row]=-1; }
}

int main() {
    printf("All %d-Queens Board Configurations:\n\n", N);
    solve(0);
    printf("Total Solutions: %d\n", solutions);
    return 0;
}
