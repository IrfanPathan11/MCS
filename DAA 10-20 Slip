int hamUtil(int pos) {
    if (pos==V) return graph[path[pos-1]][path[0]];
    int v;
    for (v=1; v<V; v++) {
        if (isSafe(v,pos)) {
            path[pos]=v;
            if (hamUtil(pos+1)) return 1;
            path[pos]=-1;
        }
    }
    return 0;
}

int main() {
    int i;
    for (i=0; i<V; i++) path[i]=-1;
    path[0]=0;
    if (hamUtil(1)) {
