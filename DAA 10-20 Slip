#include <stdio.h>
#include <limits.h>
#define V 5

int minDist(int dist[], int visited[]) {
    int min=INT_MAX, min_v=-1, v;
    for (v=0; v<V; v++)
        if (!visited[v] && dist[v]<=min) { min=dist[v]; min_v=v; }
    return min_v;
}

void dijkstra(int graph[V][V], int src) {
    int dist[V], visited[V], i, count, u, v;
    for (i=0; i<V; i++) { dist[i]=INT_MAX; visited[i]=0; }
    dist[src]=0;
    for (count=0; count<V-1; count++) {
        u=minDist(dist,visited); visited[u]=1;
        for (v=0; v<V; v++)
            if (!visited[v]&&graph[u][v]&&dist[u]!=INT_MAX&&dist[u]+graph[u][v]<dist[v])
                dist[v]=dist[u]+graph[u][v];
    }
    printf("Vertex\tDistance from %d\n", src);
    for (i=0; i<V; i++) printf("  %d\t%d\n", i, dist[i]);
}

int main() {
    int g[V][V]={{0,4,0,0,8},{4,0,8,0,11},{0,8,0,7,0},{0,0,7,0,9},{8,11,0,9,0}};
