        state[v]=2; printf("E-node (expanding): %d\n", v);
        int w;
        for (w=0; w<V; w++)
            if (adj[v][w] && state[w]==0) {
                state[w]=1; queue[rear++]=w;
                printf("  Live node added: %d\n", w);
            }
        state[v]=3; printf("Dead node: %d\n", v);
    }
}

