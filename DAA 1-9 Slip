#include <stdio.h>
#include <string.h>
#define MAX 100

int lcsLength(char X[], char Y[]) {
    int m = strlen(X), n = strlen(Y);
    int dp[MAX][MAX] = {0};
    int i, j;
    for (i = 1; i <= m; i++)
        for (j = 1; j <= n; j++)
            dp[i][j] = (X[i-1] == Y[j-1])
                      ? dp[i-1][j-1] + 1
                      : (dp[i-1][j] > dp[i][j-1] ? dp[i-1][j] : dp[i][j-1]);
    return dp[m][n];
}

int main() {
    char X[] = "AGGTAB";
    char Y[] = "GXTXAYB";
    printf("LCS length of '%s' and '%s' = %d\n", X, Y, lcsLength(X, Y));
    return 0;
}
