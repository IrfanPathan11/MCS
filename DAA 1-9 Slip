int adj[V][V], inDegree[V];
int queue[V], front = 0, rear = 0;

void topoSort() {
    int i, v, u;
    for (i = 0; i < V; i++)
        for (v = 0; v < V; v++)
            if (adj[i][v]) inDegree[v]++;
    for (i = 0; i < V; i++)
        if (inDegree[i] == 0) queue[rear++] = i;
    printf("Topological Order: ");
    int count = 0;
    while (front < rear) {
        u = queue[front++]; printf("%d ", u); count++;
        for (v = 0; v < V; v++)
            if (adj[u][v]) { inDegree[v]--; if (inDegree[v]==0) queue[rear++]=v; }
    }
    if (count != V) printf("\n(Cycle detected!)");
    printf("\nTime Complexity: O(V+E)\n");
}

