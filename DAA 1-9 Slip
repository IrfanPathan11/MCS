#include <stdio.h>
#include <stdlib.h>
#define N 7

typedef struct { int id; float ratio, weight, value; } Item;

int cmp(const void *a, const void *b) {
    float d = ((Item*)b)->ratio - ((Item*)a)->ratio;
    return (d > 0) - (d < 0);
}

int main() {
    float w[] = {2,3,5,7,1,4,1};
    float v[] = {10,5,15,7,6,18,3};
    float capacity = 15;
    Item items[N];
    int i;
    for (i = 0; i < N; i++) {
        items[i].id = i; items[i].weight = w[i];
        items[i].value = v[i]; items[i].ratio = v[i]/w[i];
    }
    qsort(items, N, sizeof(Item), cmp);
    float total = 0;
    for (i = 0; i < N && capacity > 0; i++) {
        if (items[i].weight <= capacity) {
            total += items[i].value;
            capacity -= items[i].weight;
            printf("Item %d: full\n", items[i].id);
        } else {
            float frac = capacity / items[i].weight;
            total += frac * items[i].value;
            printf("Item %d: %.2f fraction\n", items[i].id, frac);
            capacity = 0;
        }
    }
    printf("Max Value: %.2f\n", total);
    return 0;
}
