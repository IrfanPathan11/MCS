#include <stdio.h>
#include <time.h>
#include <stdlib.h>

void selectionSort(int arr[], int n) {
    int i, j, minIdx, temp;
    for (i = 0; i < n-1; i++) {
        minIdx = i;
        for (j = i+1; j < n; j++)
            if (arr[j] < arr[minIdx]) minIdx = j;
        temp = arr[i]; arr[i] = arr[minIdx]; arr[minIdx] = temp;
    }
}

int main() {
    int sizes[] = {100, 500, 1000, 5000};
    int k, i;
    for (k = 0; k < 4; k++) {
        int n = sizes[k];
        int *arr = (int*)malloc(n * sizeof(int));
        for (i = 0; i < n; i++) arr[i] = rand() % 10000;
        clock_t start = clock();
        selectionSort(arr, n);
        double elapsed = (double)(clock()-start)/CLOCKS_PER_SEC;
        printf("n=%5d  Time=%.6f s\n", n, elapsed);
        free(arr);
    }
    return 0;
}
