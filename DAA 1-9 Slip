int visited[N];

int tspNearest(int dist[N][N], int start) {
    int i, cur = start, total = 0, step, j;
    for (i = 0; i < N; i++) visited[i] = 0;
    visited[start] = 1;
    printf("Tour: %d", start);
    for (step = 0; step < N-1; step++) {
        int nearest = -1, minD = INT_MAX;
        for (j = 0; j < N; j++)
            if (!visited[j] && dist[cur][j] < minD)
                { minD = dist[cur][j]; nearest = j; }
        visited[nearest] = 1; total += minD;
        cur = nearest; printf(" -> %d", cur);
