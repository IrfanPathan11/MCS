#include <stdio.h>
#define N 2

/* Note: This implements 2x2 Strassen.
   For larger matrices, divide recursively into 2x2 blocks. */

void strassen(int A[N][N], int B[N][N], int C[N][N]) {
    int p1 = A[0][0] * (B[0][1] - B[1][1]);
    int p2 = (A[0][0] + A[0][1]) * B[1][1];
    int p3 = (A[1][0] + A[1][1]) * B[0][0];
    int p4 = A[1][1] * (B[1][0] - B[0][0]);
    int p5 = (A[0][0] + A[1][1]) * (B[0][0] + B[1][1]);
    int p6 = (A[0][1] - A[1][1]) * (B[1][0] + B[1][1]);
    int p7 = (A[0][0] - A[1][0]) * (B[0][0] + B[0][1]);
    C[0][0] = p5 + p4 - p2 + p6;
    C[0][1] = p1 + p2;
    C[1][0] = p3 + p4;
    C[1][1] = p5 + p1 - p3 - p7;
}

int main() {
    int A[N][N] = {{1,2},{3,4}};
    int B[N][N] = {{5,6},{7,8}};
    int C[N][N] = {{0}};
    int i, j;
    strassen(A, B, C);
    printf("Strassen Result:\n");
    for (i = 0; i < N; i++) {
        for (j = 0; j < N; j++) printf("%4d ", C[i][j]);
        printf("\n");
    }
    return 0;
}
