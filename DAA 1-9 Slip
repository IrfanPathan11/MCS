        clock_t start = clock();
        quickSort(arr, 0, n-1);
        double elapsed = (double)(clock()-start)/CLOCKS_PER_SEC;
        printf("n=%6d  Time=%.6f s\n", n, elapsed);
        free(arr);
    }
    return 0;
}
