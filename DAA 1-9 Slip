Q.2 – Huffman Coding (Greedy)

⧉
Copy
#include <stdio.h>
#include <stdlib.h>
#define MAX 100

typedef struct Node {
    char ch; int freq;
    struct Node *left, *right;
} Node;

Node* newNode(char ch, int freq) {
    Node* n = (Node*)malloc(sizeof(Node));
    n->ch = ch; n->freq = freq; n->left = n->right = NULL;
    return n;
}

Node* heap[MAX]; int heapSize = 0;

void push(Node* n) {
    int i = heapSize++;
    while (i > 0) {
        int p = (i-1)/2;
        if (heap[p]->freq <= n->freq) break;
        heap[i] = heap[p]; i = p;
    }
    heap[i] = n;
}

Node* pop() {
    Node* top = heap[0];
    Node* last = heap[--heapSize];
    int i = 0;
    while (1) {
        int l=2*i+1, r=2*i+2, s=i;
        if (l<heapSize && heap[l]->freq<heap[s]->freq) s=l;
        if (r<heapSize && heap[r]->freq<heap[s]->freq) s=r;
        if (s==i) break;
        heap[i]=heap[s]; heap[s]=last; i=s;
    }
    heap[i] = last;
    return top;
}

void printCodes(Node* root, char* code, int depth) {
    if (!root) return;
    if (root->ch) { code[depth]=''; printf("  '%c': %s\n", root->ch, code); return; }
    code[depth]='0'; printCodes(root->left,  code, depth+1);
    code[depth]='1'; printCodes(root->right, code, depth+1);
}

int main() {
    char chars[] = {'a','b','c','d','e','f'};
    int  freqs[] = { 5,  9, 12, 13, 16, 45};
    int n = 6, i;
    for (i = 0; i < n; i++) push(newNode(chars[i], freqs[i]));
    while (heapSize > 1) {
        Node *l = pop(), *r = pop();
        Node *m = newNode(0, l->freq + r->freq);
        m->left = l; m->right = r; push(m);
    }
    char code[MAX];
    printf("Huffman Codes:\n");
    printCodes(heap[0], code, 0);
    printf("Time Complexity: O(n log n)\n");
    return 0;
}
